#!/bin/sh
# Auto-detect the system's DNS resolver IP and export it as RESOLVER_IP.
# nginx then uses this for runtime hostname re-resolution so we don't get
# stuck on stale IPs after upstream container redeploys.
#
# Lives at /docker-entrypoint.d/00-export-resolver.envsh — nginx:alpine
# runs every executable in /docker-entrypoint.d/ in alphanumeric order at
# startup, so this runs BEFORE the envsubst hook (20-envsubst-on-templates.sh).
#
# IMPORTANT: file MUST end in .envsh (sourced) — .sh files are run in a
# subshell so `export` doesn't survive.
#
# Handles IPv6 (Railway uses fd12::10) by wrapping in [] as nginx requires.
# Falls back to Cloudflare/Google public DNS if /etc/resolv.conf has nothing.

set -e

NAMESERVER=$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf 2>/dev/null || true)

# nginx's `resolver` directive requires IPv6 addresses wrapped in [].
# An IPv6 address contains a colon; an IPv4 address never does.
case "$NAMESERVER" in
    *:*)
        RESOLVER_IP="[${NAMESERVER}]"
        ;;
    "")
        RESOLVER_IP="1.1.1.1 8.8.8.8"
        echo "[entrypoint] no nameserver in /etc/resolv.conf, falling back to public DNS"
        ;;
    *)
        RESOLVER_IP="$NAMESERVER"
        ;;
esac

echo "[entrypoint] using DNS resolver: $RESOLVER_IP"
export RESOLVER_IP
