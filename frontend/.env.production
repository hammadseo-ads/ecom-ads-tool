# Production build (npm run build) served by nginx in Docker.
# nginx proxies /api/* to the backend container, so relative URLs work for any domain.
# To change domain, no edits needed here — just point DNS at your server.
VITE_API_URL=/api
VITE_API_AUTH_URL=/api/auth
VITE_API_GOOGLE_ADS_URL=/api/google-ads
